# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# All values come from Firebase console → Project settings → Your apps → Web app.

# --- Firebase web app config ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore database id. Leave blank for the auto-created (default); this project
# uses a database literally named "default".
VITE_FIRESTORE_DATABASE_ID=default

# --- App Check ---
# Firebase AI Logic requires App Check. Register the web app with a reCAPTCHA
# Enterprise site key and add BOTH localhost and your Hosting domain.
#
# If reCAPTCHA Enterprise creation demands a billing account, either:
#   - set VITE_APP_CHECK_PROVIDER=v3 (reCAPTCHA v3 provider, also accepted), or
#   - set VITE_APP_CHECK_DEBUG=true and register the debug token below.
VITE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_PROVIDER=enterprise
VITE_APP_CHECK_DEBUG=false
# Printed in the browser console on first run when VITE_APP_CHECK_DEBUG=true.
# Register that token under App Check → Apps → Manage debug tokens.
VITE_APP_CHECK_DEBUG_TOKEN=
