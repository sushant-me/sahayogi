rules_version = '2';

// Sahayogi security rules.
//
// Anonymous Auth gives every visitor a real uid, and these rules make that uid the only key
// to its own data. Every path the app uses is named explicitly — there is no wildcard under
// a user, so a subcollection added later is closed by default rather than silently readable.
//
// Invariants this encodes:
//   * chats belong to one owner: read, create, update and delete are owner-only
//   * messages are append-only: they can be created and read, never edited or deleted, so a
//     stored answer's routing evidence cannot be rewritten after the fact
//   * the self-check may create, read and delete its own throwaway probe document
//   * everything not named here is denied
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/chats/{chatId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update, delete: if owner(uid);
    }

    // Append-only: no update, no delete.
    match /users/{uid}/chats/{chatId}/messages/{messageId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 20000
        && request.resource.data.role in ['user', 'model'];
    }

    // The in-app self-check writes a throwaway document and deletes it again.
    match /users/{uid}/selfChecks/{checkId} {
      allow read, create, delete: if owner(uid);
    }

    // Effective routing policy snapshot per user.
    match /settings/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
